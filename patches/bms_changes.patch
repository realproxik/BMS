+
+void RenderViewHostImpl::OnBmsSearch(const std::string& query) {
+  BMS_DEBUG_LOG("BMS Search: " << query);
+
+  // Perform global search
+  auto results = BMSGlobalSearch::GetInstance()->Search(query);
+
+  // Send results back to renderer
+  if (render_widget_host_) {
+    std::string results_json = BMSGlobalSearch::ResultsToJson(results);
+    render_widget_host_->ExecuteJavaScript(
+        "window.__bms_search_results = " + results_json + ";");
+  }
+}
+
+void RenderViewHostImpl::OnBmsIgnore(const std::string& path) {
+  BMS_DEBUG_LOG("BMS Ignore: " << path);
+
+  if (BMSIgnoreSystem::ShouldIgnore(path)) {
+    // Notify renderer that path is ignored
+    if (render_widget_host_) {
+      render_widget_host_->ExecuteJavaScript(
+          "window.__bms_ignored_path = '" + path + "';");
+    }
+  }
+}
+
+void RenderViewHostImpl::OnBmsApiCall(const std::string& name,
+                                      const std::string& data) {
+  BMS_DEBUG_LOG("BMS API Call: " << name << "(" << data << ")");
+
+  // Route to BMS API handler
+  BMSApiSystem::GetInstance()->Call(name, data);
+}
+
+void RenderViewHostImpl::OnBmsDomQuery(const std::string& selector) {
+  BMS_DEBUG_LOG("BMS DOM Query: " << selector);
+
+  // Query DOM using BMS DOM engine
+  if (bms_dom_engine_) {
+    BMSNode* node = bms_dom_engine_->QuerySelector(selector);
+    if (node) {
+      // Send node data back to renderer
+      std::string node_data = BMSDomEngine::NodeToJson(node);
+      if (render_widget_host_) {
+        render_widget_host_->ExecuteJavaScript(
+            "window.__bms_dom_result = " + node_data + ";");
+      }
+    }
+  }
+}
+
+void RenderViewHostImpl::OnBmsSearchGlobal(const std::string& query) {
+  BMS_DEBUG_LOG("BMS Global Search: " << query);
+
+  // Search across all websites
+  auto results = BMSGlobalSearch::GetInstance()->SearchGlobal(query);
+  if (render_widget_host_) {
+    std::string results_json = BMSGlobalSearch::ResultsToJson(results);
+    render_widget_host_->ExecuteJavaScript(
+        "window.__bms_global_search_results = " + results_json + ";");
+  }
+}
+
+void RenderViewHostImpl::OnBmsIndexPage(const std::string& url,
+                                       const std::string& content) {
+  BMS_DEBUG_LOG("BMS Index Page: " << url);
+
+  BMSGlobalSearch::GetInstance()->IndexPage(url, content);
+}
+
+void RenderViewHostImpl::OnBmsCrawlWebsite(const std::string& url,
+                                          int max_pages) {
+  BMS_DEBUG_LOG("BMS Crawl Website: " << url << " (max: " << max_pages << ")");
+
+  // Start crawling in background thread
+  std::thread([url, max_pages]() {
+    BMSGlobalSearch::GetInstance()->CrawlWebsite(url, max_pages);
+  }).detach();
+}
+
+void RenderViewHostImpl::OnBmsGetRelatedPages(const std::string& url,
