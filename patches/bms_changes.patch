+  // DOM Query API
+  RegisterApi("dom_query", [](const std::string& data) -> std::string {
+    auto* engine = BMS::DOM::BMSDomEngine::GetInstance();
+    auto* node = engine->QuerySelector(data);
+    if (node) {
+      return "{\"found\":true,\"type\":" +
+             std::to_string(static_cast<int>(node->GetType())) + "}";
+    }
+    return "{\"found\":false}";
+  });
+
+  // Get Top Pages API
+  RegisterApi("top_pages", [](const std::string& data) -> std::string {
+    int count = 10;
+    if (!data.empty()) {
+      count = std::stoi(data);
+    }
+    auto pages = BMS::Search::BMSGlobalSearch::GetInstance()->GetTopPages(count);
+    std::stringstream ss;
+    ss << "[";
+    for (size_t i = 0; i < pages.size(); ++i) {
+      ss << "\"" << pages[i] << "\"";
+      if (i < pages.size() - 1) ss << ",";
+    }
+    ss << "]";
+    return ss.str();
+  });
+
+  // Statistics API
+  RegisterApi("stats", [](const std::string& data) -> std::string {
+    auto* search = BMS::Search::BMSGlobalSearch::GetInstance();
+    auto* dom = BMS::DOM::BMSDomEngine::GetInstance();
+    auto* ignore = BMS::Ignore::BMSIgnoreSystem::GetInstance();
+
+    std::stringstream ss;
+    ss << "{";
+    ss << "\"search_engine\":\"BMS Global Search\",";
+    ss << "\"dom_engine\":\"BMS DOM Engine v1.0\",";
+    ss << "\"ignore_system\":\"" << (ignore->IsLoaded() ? "loaded" : "not_loaded") << "\",";
+    ss << "\"version\":\"1.0.0\"";
