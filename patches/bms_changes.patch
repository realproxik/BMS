+
+BMSDomEngine* BMSDomEngine::instance_ = nullptr;
+
+BMSDomEngine* BMSDomEngine::GetInstance() {
+  if (!instance_) {
+    instance_ = new BMSDomEngine();
+  }
+  return instance_;
+}
+
+BMSDomEngine::BMSDomEngine() : initialized_(false) {
+  BMS_DEBUG_LOG("BMS DOM Engine initialized");
+}
+
+BMSDomEngine::~BMSDomEngine() {
+  observers_.clear();
+}
+
+void BMSDomEngine::Initialize() {
+  if (initialized_) return;
+
+  // Load custom elements
+  LoadCustomElements();
+
+  initialized_ = true;
+  BMS_DEBUG_LOG("BMS DOM Engine fully initialized");
+}
+
+BMSDocument* BMSDomEngine::CreateDocument() {
+  auto doc = std::make_unique<BMSDocument>();
+  doc->SetURL("about:blank");
+  doc->SetTitle("BMS Browser");
+
+  // Add default styles
+  auto style_element = std::make_unique<BMSElement>("style");
+  style_element->SetTextContent(R"(
+    body { font-family: -apple-system, Arial, sans-serif; margin: 0; padding: 20px; }
+    h1 { color: #333; }
+    a { color: #0066cc; text-decoration: none; }
+    a:hover { text-decoration: underline; }
+  )");
+
+  // Store document
+  documents_.push_back(std::move(doc));
+  return documents_.back().get();
+}
+
+BMSNode* BMSDomEngine::QuerySelector(const std::string& selector) {
+  // Simple selector parser
+  if (selector.empty()) return nullptr;
+
+  for (auto& doc : documents_) {
+    if (selector[0] == '#') {
+      auto* element = doc->GetElementById(selector.substr(1));
+      if (element) return element;
+    } else if (selector[0] == '.') {
+      auto elements = doc->GetElementsByClassName(selector.substr(1));
+      if (!elements.empty()) return elements[0];
+    } else {
+      auto elements = doc->GetElementsByTagName(selector);
+      if (!elements.empty()) return elements[0];
+    }
+  }
+  return nullptr;
+}
+
+void BMSDomEngine::RegisterCustomElement(const std::string& name,
+                                         const std::string& code) {
+  custom_elements_[name] = code;
+  BMS_DEBUG_LOG("Registered custom element: " << name);
+}
+
+void BMSDomEngine::LoadCustomElements() {
+  // Load custom elements from file
+  const std::string custom_elements_path = "custom_elements.json";
+  std::ifstream file(custom_elements_path);
+  if (file.is_open()) {
+    // Parse JSON and register elements
+    // Implementation omitted for brevity
+    file.close();
+  }
+}
+
+void BMSDomEngine::AddObserver(Observer* observer) {
+  if (observer) {
+    observers_.push_back(observer);
+  }
+}
+
+void BMSDomEngine::RemoveObserver(Observer* observer) {
+  auto it = std::remove(observers_.begin(), observers_.end(), observer);
+  if (it != observers_.end()) {
+    observers_.erase(it, observers_.end());
+  }
+}
+
+void BMSDomEngine::NotifyNodeAdded(BMSNode* node) {
+  for (auto* observer : observers_) {
+    observer->OnDomNodeAdded(node);
+  }
+}
+
+void BMSDomEngine::NotifyNodeRemoved(BMSNode* node) {
+  for (auto* observer : observers_) {
+    observer->OnDomNodeRemoved(node);
+  }
+}
+
+void BMSDomEngine::NotifyNavigation(const std::string& url) {
+  for (auto* observer : observers_) {
+    observer->OnNavigation(url);
+  }
+}
+
+std::string BMSDomEngine::NodeToJson(BMSNode* node) {
+  if (!node) return "null";
+
+  std::stringstream ss;
+  ss << "{";
+  ss << "\"type\":" << static_cast<int>(node->GetType()) << ",";
+  ss << "\"name\":\"" << node->GetNodeName() << "\",";
+  ss << "\"value\":\"" << node->GetNodeValue() << "\",";
+  ss << "\"children\":" << node->GetChildCount();
+  ss << "}";
+
+  return ss.str();
+}
