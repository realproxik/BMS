+void BMSApiSystem::RegisterDefaultApis() {
+  // Search API
+  RegisterApi("search", [](const std::string& data) -> std::string {
+    auto results = BMS::Search::BMSGlobalSearch::GetInstance()->Search(data, 50);
+    return BMS::Search::BMSGlobalSearch::GetInstance()->ResultsToJson(results);
+  });
+
+  // Search Global API
+  RegisterApi("search_global", [](const std::string& data) -> std::string {
+    auto results = BMS::Search::BMSGlobalSearch::GetInstance()->SearchGlobal(data, 100);
+    return BMS::Search::BMSGlobalSearch::GetInstance()->ResultsToJson(results);
+  });
+
+  // Index Page API
+  RegisterApi("index_page", [](const std::string& data) -> std::string {
+    // Parse JSON data
+    // In production, use a proper JSON parser
+    return "{\"status\":\"ok\"}";
+  });
+
+  // Crawl API
+  RegisterApi("crawl", [](const std::string& data) -> std::string {
+    // Start crawling in background
+    std::thread([data]() {
+      BMS::Search::BMSGlobalSearch::GetInstance()->CrawlWebsite(data, 100);
+    }).detach();
+    return "{\"status\":\"crawling_started\"}";
