+    std::stringstream ss;
+    ss << "[";
+    for (size_t i = 0; i < pages.size(); ++i) {
+      ss << "\"" << pages[i] << "\"";
+      if (i < pages.size() - 1) ss << ",";
+    }
+    ss << "]";
+    return ss.str();
+  });
+
+  // Custom Element API
+  RegisterApi("custom_element", [](const std::string& data) -> std::string {
+    // Parse name and code from JSON
+    // In production, use proper JSON parsing
+    return "{\"status\":\"ok\"}";
+  });
+}
+
+std::string BMSApiSystem::Call(const std::string& name, const std::string& data) {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  auto it = apis_.find(name);
+  if (it == apis_.end()) {
+    BMS_DEBUG_LOG("API not found: " << name);
+    return "{\"error\":\"API not found\"}";
+  }
+
+  try {
+    BMS_DEBUG_LOG("Calling API: " << name << "(" << data << ")");
+    return it->second(data);
+  } catch (const std::exception& e) {
+    BMS_DEBUG_LOG("API call failed: " << e.what());
+    return "{\"error\":\"" + std::string(e.what()) + "\"}";
+  }
+}
+
+void BMSApiSystem::RegisterModule(const std::string& name, void* module) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  modules_[name] = module;
+  BMS_DEBUG_LOG("Registered API module: " << name);
+}
+
+void BMSApiSystem::LoadApiModules() {
+  // Load API modules from directory
+  const std::string modules_dir = "bms_modules";
+
+  std::vector<std::string> module_files;
+  // In production, scan directory for .bms files
+
+  for (const auto& file : module_files) {
+    LoadApiModule(file);
+  }
+}
+
+void BMSApiSystem::LoadApiModule(const std::string& path) {
+  std::ifstream file(path);
+  if (!file.is_open()) {
+    BMS_DEBUG_LOG("Failed to load API module: " << path);
+    return;
+  }
+
+  std::string content((std::istreambuf_iterator<char>(file)),
+                      std::istreambuf_iterator<char>());
+  file.close();
+
+  // Parse module (simplified)
+  // In production, use a proper module system
+  BMS_DEBUG_LOG("Loaded API module: " << path);
+}
