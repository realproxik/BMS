+
+  // Start background indexing thread
+  std::thread([this]() {
+    while (true) {
+      ProcessIndexQueue();
+      std::this_thread::sleep_for(std::chrono::seconds(10));
+    }
+  }).detach();
+
+  initialized_ = true;
+  BMS_DEBUG_LOG("BMS Global Search initialized");
+}
+
+void BMSGlobalSearch::IndexPage(const std::string& url,
+                                const std::string& html,
+                                const std::string& title) {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  SearchEntry entry;
+  entry.url = url;
+  entry.title = title.empty() ? "Page" : title;
+  entry.content = html;
+  entry.relevance = 0.0f;
+  entry.visits = 1;
+  entry.last_visited = std::chrono::system_clock::now();
+
+  // Extract keywords and metadata
+  ExtractKeywords(entry);
+
+  index_[url] = entry;
+  BMS_DEBUG_LOG("Indexed page: " << url << " (" << html.length() << " bytes)");
+}
+
+void BMSGlobalSearch::IndexNode(BMSNode* node) {
+  if (!node) return;
+
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::string content = node->GetTextContent();
+  if (content.empty()) return;
+
+  std::string url = node->GetOwnerDocument() ?
+      node->GetOwnerDocument()->GetURL() : "node";
+
+  // Add to index
+  auto it = index_.find(url);
+  if (it != index_.end()) {
+    it->second.content += " " + content;
+    ExtractKeywords(it->second);
+  } else {
+    SearchEntry entry;
+    entry.url = url;
+    entry.title = "DOM Node";
+    entry.content = content;
+    entry.last_visited = std::chrono::system_clock::now();
+    ExtractKeywords(entry);
+    index_[url] = entry;
+  }
+}
+
+void BMSGlobalSearch::RemoveNode(BMSNode* node) {
+  if (!node) return;
+
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::string url = node->GetOwnerDocument() ?
+      node->GetOwnerDocument()->GetURL() : "node";
+
+  index_.erase(url);
+}
+
+std::vector<SearchResult> BMSGlobalSearch::Search(const std::string& query,
+                                                  int max_results) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::vector<SearchResult> results;
+
+  // Normalize query
+  std::string normalized_query = query;
+  std::transform(normalized_query.begin(), normalized_query.end(),
+                normalized_query.begin(), ::tolower);
+
+  // Search in index
+  for (const auto& [url, entry] : index_) {
+    float relevance = CalculateRelevance(entry.content, normalized_query);
+    if (relevance > 0.1f) {
+      SearchResult result;
+      result.url = url;
+      result.title = entry.title;
+      result.snippet = GenerateSnippet(entry.content, query);
+      result.relevance = relevance;
+      result.last_visited = entry.last_visited;
+      results.push_back(result);
+    }
+  }
+
+  // Sort by relevance
+  std::sort(results.begin(), results.end(),
+      [](const SearchResult& a, const SearchResult& b) {
+        return a.relevance > b.relevance;
+      });
+
+  // Limit results
+  int limit = std::min(max_results, static_cast<int>(results.size()));
+  results.resize(limit);
+
+  return results;
+}
+
+std::vector<SearchResult> BMSGlobalSearch::SearchGlobal(const std::string& query,
+                                                        int max_results) {
+  // Search across all indexed websites
+  std::vector<SearchResult> results = Search(query, max_results);
+
+  // Add results from external search engines
+  std::vector<SearchResult> external_results = SearchExternal(query);
+  results.insert(results.end(), external_results.begin(), external_results.end());
+
+  // Re-sort with combined relevance
+  std::sort(results.begin(), results.end(),
+      [](const SearchResult& a, const SearchResult& b) {
+        return a.relevance > b.relevance;
+      });
+
+  // Limit results
+  if (results.size() > static_cast<size_t>(max_results)) {
+    results.resize(max_results);
+  }
+
+  return results;
+}
+
+void BMSGlobalSearch::CrawlWebsite(const std::string& start_url, int max_pages) {
+  BMS_DEBUG_LOG("Crawling website: " << start_url << " (max: " << max_pages << ")");
+
+  std::queue<std::string> url_queue;
+  std::unordered_set<std::string> visited;
+  int crawled = 0;
+
+  url_queue.push(start_url);
+
+  while (!url_queue.empty() && crawled < max_pages) {
+    std::string url = url_queue.front();
+    url_queue.pop();
+
+    if (visited.find(url) != visited.end()) continue;
+    visited.insert(url);
+
+    // Fetch page
+    std::string html = FetchPage(url);
+    if (html.empty()) continue;
+
+    // Index page
+    IndexPage(url, html);
+    crawled++;
+
+    // Extract links
+    std::vector<std::string> links = ExtractLinks(html);
+    for (const auto& link : links) {
+      if (visited.find(link) == visited.end()) {
+        url_queue.push(link);
+      }
+    }
+  }
+
+  BMS_DEBUG_LOG("Crawled " << crawled << " pages from " << start_url);
+}
+
+std::vector<std::string> BMSGlobalSearch::GetRelatedPages(const std::string& url,
+                                                          int max_results) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::vector<std::pair<std::string, float>> related;
+
+  auto it = index_.find(url);
+  if (it == index_.end()) return {};
+
+  const auto& entry = it->second;
+
+  // Find pages with similar content
+  for (const auto& [other_url, other_entry] : index_) {
+    if (other_url != url) {
+      float similarity = CalculateSimilarity(entry.content, other_entry.content);
+      if (similarity > 0.3f) {
+        related.push_back({other_url, similarity});
+      }
+    }
+  }
+
+  // Sort by similarity
+  std::sort(related.begin(), related.end(),
+      [](const auto& a, const auto& b) {
+        return a.second > b.second;
+      });
+
+  std::vector<std::string> results;
+  for (int i = 0; i < max_results && i < static_cast<int>(related.size()); ++i) {
+    results.push_back(related[i].first);
+  }
+
+  return results;
+}
+
+std::vector<std::string> BMSGlobalSearch::GetTopPages(int count) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::vector<std::pair<std::string, int>> page_visits;
+
+  for (const auto& [url, entry] : index_) {
+    page_visits.push_back({url, entry.visits});
+  }
+
+  std::sort(page_visits.begin(), page_visits.end(),
+      [](const auto& a, const auto& b) {
+        return a.second > b.second;
+      });
+
+  std::vector<std::string> results;
+  for (int i = 0; i < count && i < static_cast<int>(page_visits.size()); ++i) {
+    results.push_back(page_visits[i].first);
+  }
+
+  return results;
+}
+
+std::string BMSGlobalSearch::ResultsToJson(const std::vector<SearchResult>& results) {
+  std::stringstream ss;
+  ss << "[";
+
+  for (size_t i = 0; i < results.size(); ++i) {
+    const auto& result = results[i];
+    ss << "{";
+    ss << "\"url\":\"" << result.url << "\",";
+    ss << "\"title\":\"" << result.title << "\",";
+    ss << "\"snippet\":\"" << result.snippet << "\",";
+    ss << "\"relevance\":" << result.relevance;
+    ss << "}";
+
+    if (i < results.size() - 1) {
+      ss << ",";
+    }
+  }
+
+  ss << "]";
+  return ss.str();
+}
+
+void BMSGlobalSearch::SaveIndex() {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::ofstream file("bms_search_index.json");
+  if (!file.is_open()) {
+    BMS_DEBUG_LOG("Failed to save search index");
+    return;
+  }
+
+  file << "{\n";
+  file << "  \"index\": [\n";
+
+  for (auto it = index_.begin(); it != index_.end(); ++it) {
+    const auto& [url, entry] = *it;
+    file << "    {\n";
+    file << "      \"url\": \"" << url << "\",\n";
+    file << "      \"title\": \"" << entry.title << "\",\n";
+    file << "      \"visits\": " << entry.visits << ",\n";
+    file << "      \"last_visited\": " << entry.last_visited.time_since_epoch().count() << "\n";
+    file << "    }";
+
+    if (std::next(it) != index_.end()) {
+      file << ",";
+    }
+    file << "\n";
+  }
+
+  file << "  ]\n";
+  file << "}\n";
+
+  file.close();
+  BMS_DEBUG_LOG("Search index saved (" << index_.size() << " entries)");
+}
+
+void BMSGlobalSearch::LoadIndex() {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::ifstream file("bms_search_index.json");
+  if (!file.is_open()) {
+    BMS_DEBUG_LOG("No existing search index found");
+    return;
+  }
+
+  // Parse JSON (simplified)
+  // In production, use a proper JSON parser
+  BMS_DEBUG_LOG("Loading search index from file");
+  file.close();
+}
+
+float BMSGlobalSearch::CalculateRelevance(const std::string& content,
+                                          const std::string& query) {
+  std::string normalized_content = content;
+  std::string normalized_query = query;
+
+  std::transform(normalized_content.begin(), normalized_content.end(),
+                normalized_content.begin(), ::tolower);
+  std::transform(normalized_query.begin(), normalized_query.end(),
+                normalized_query.begin(), ::tolower);
+
+  // Count occurrences
+  size_t pos = 0;
+  int count = 0;
+  while ((pos = normalized_content.find(normalized_query, pos)) != std::string::npos) {
+    ++count;
+    pos += normalized_query.length();
+  }
+
+  if (count == 0) return 0.0f;
+
+  // Normalize by content length
+  float relevance = static_cast<float>(count) / (normalized_content.length() / 100);
+  return std::min(1.0f, relevance);
+}
+
+std::string BMSGlobalSearch::GenerateSnippet(const std::string& content,
+                                             const std::string& query) {
+  // Find query in content and return surrounding text
+  std::string normalized_content = content;
+  std::string normalized_query = query;
+
+  std::transform(normalized_content.begin(), normalized_content.end(),
+                normalized_content.begin(), ::tolower);
+  std::transform(normalized_query.begin(), normalized_query.end(),
+                normalized_query.begin(), ::tolower);
+
+  size_t pos = normalized_content.find(normalized_query);
+  if (pos == std::string::npos) {
+    // Return first 150 characters
+    return content.substr(0, 150) + "...";
+  }
+
+  // Return context around query
+  size_t start = pos > 50 ? pos - 50 : 0;
+  size_t length = std::min(static_cast<size_t>(200), content.length() - start);
+  std::string snippet = content.substr(start, length);
+
+  if (start > 0) snippet = "..." + snippet;
+  if (start + length < content.length()) snippet += "...";
+
+  return snippet;
+}
+
+void BMSGlobalSearch::ExtractKeywords(SearchEntry& entry) {
+  // Simple keyword extraction
+  std::regex word_pattern(R"(\b[a-zA-Z]{3,}\b)");
+  auto begin = std::sregex_iterator(entry.content.begin(),
+                                    entry.content.end(), word_pattern);
+  auto end = std::sregex_iterator();
+
+  std::unordered_map<std::string, int> word_count;
+  for (auto it = begin; it != end; ++it) {
+    std::string word = it->str();
+    std::transform(word.begin(), word.end(), word.begin(), ::tolower);
+    word_count[word]++;
+  }
+
+  // Store top keywords
+  entry.keywords.clear();
+  std::vector<std::pair<std::string, int>> sorted_words(word_count.begin(),
+                                                        word_count.end());
+  std::sort(sorted_words.begin(), sorted_words.end(),
+      [](const auto& a, const auto& b) {
+        return a.second > b.second;
+      });
+
+  for (int i = 0; i < 10 && i < static_cast<int>(sorted_words.size()); ++i) {
+    entry.keywords.push_back(sorted_words[i].first);
+  }
+}
+
+}  // namespace Search
+}  // namespace BMS
