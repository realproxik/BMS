+BMSIgnoreSystem::BMSIgnoreSystem() : loaded_(false) {
+  // Initialize with default patterns
+  AddPattern("*.tmp", false);
+  AddPattern("*.temp", false);
+  AddPattern("*.log", false);
+  AddPattern("*.bak", false);
+  AddPattern("*.cache", false);
+  AddPattern("*.swp", false);
+  AddPattern("*.swo", false);
+  AddPattern("node_modules/", false);
+  AddPattern("__pycache__/", false);
+  AddPattern(".git/", false);
+  AddPattern(".svn/", false);
+  AddPattern(".vscode/", false);
+  AddPattern(".idea/", false);
+  AddPattern("build/", false);
+  AddPattern("debug/", false);
+  AddPattern("release/", false);
+  AddPattern("*.exe", false);
+  AddPattern("*.dll", false);
+  AddPattern("*.so", false);
+  AddPattern("*.o", false);
+  AddPattern("*.obj", false);
+}
+
+BMSIgnoreSystem::~BMSIgnoreSystem() = default;
+
+void BMSIgnoreSystem::LoadIgnoreFile(const std::string& path) {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  std::ifstream file(path);
+  if (!file.is_open()) {
+    BMS_DEBUG_LOG("Ignore file not found: " << path);
+    return;
+  }
+
+  std::string line;
+  while (std::getline(file, line)) {
+    // Skip comments and empty lines
+    if (line.empty() || line[0] == '#') continue;
+
+    // Check for regex pattern
+    bool is_regex = false;
+    if (line.find('*') != std::string::npos ||
+        line.find('?') != std::string::npos ||
+        line.find('[') != std::string::npos ||
+        line.find(']') != std::string::npos) {
+      is_regex = true;
+    }
+
+    // Check for negated pattern
+    if (line[0] == '!') {
+      // Negated patterns - we'll handle separately
+      continue;
+    }
+
+    AddPattern(line, is_regex);
+  }
+
+  file.close();
+  loaded_ = true;
+  BMS_DEBUG_LOG("Loaded ignore file: " << path << " (" << patterns_.size() << " patterns)");
+}
+
+void BMSIgnoreSystem::AddPattern(const std::string& pattern, bool is_regex) {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  IgnorePattern ignore_pattern;
+  ignore_pattern.pattern = pattern;
+  ignore_pattern.is_regex = is_regex;
+  ignore_pattern.is_negated = false;
+
+  patterns_.push_back(ignore_pattern);
+  BMS_DEBUG_LOG("Added ignore pattern: " << pattern);
+}
+
+void BMSIgnoreSystem::RemovePattern(const std::string& pattern) {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  auto it = std::remove_if(patterns_.begin(), patterns_.end(),
+      [&pattern](const IgnorePattern& p) {
+        return p.pattern == pattern;
+      });
+
+  if (it != patterns_.end()) {
+    patterns_.erase(it, patterns_.end());
+    BMS_DEBUG_LOG("Removed ignore pattern: " << pattern);
+  }
+}
+
+bool BMSIgnoreSystem::ShouldIgnore(const std::string& path) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+
+  for (const auto& pattern : patterns_) {
+    bool match = false;
+
+    if (pattern.is_regex) {
+      try {
+        std::regex regex_pattern(pattern.pattern);
+        match = std::regex_search(path, regex_pattern);
+      } catch (const std::regex_error&) {
+        // Invalid regex, treat as literal
+        match = path.find(pattern.pattern) != std::string::npos;
+      }
+    } else {
+      // Simple pattern matching with wildcards
+      match = PathMatchesPattern(path, pattern.pattern);
+    }
+
+    if (pattern.is_negated && match) {
+      // Negated pattern - do NOT ignore
+      return false;
+    }
+
+    if (match) {
+      BMS_DEBUG_LOG("Ignoring: " << path << " (pattern: " << pattern.pattern << ")");
+      return true;
+    }
+  }
+
+  return false;
+}
+
+bool BMSIgnoreSystem::IsLoaded() const {
+  return loaded_;
+}
+
+bool BMSIgnoreSystem::PathMatchesPattern(const std::string& path,
+                                         const std::string& pattern) const {
+  // Convert glob pattern to regex
+  std::string regex_pattern;
+  regex_pattern = "^";
+
+  for (char c : pattern) {
+    switch (c) {
+      case '*':
+        regex_pattern += ".*";
+        break;
+      case '?':
+        regex_pattern += ".";
+        break;
+      case '.':
+      case '+':
+      case '^':
+      case '$':
+      case '{':
+      case '}':
+      case '[':
+      case ']':
+      case '|':
+      case '\\':
+        regex_pattern += "\\";
+        regex_pattern += c;
+        break;
+      default:
+        regex_pattern += c;
+        break;
+    }
+  }
+
+  regex_pattern += "$";
+
+  try {
+    std::regex regex(regex_pattern);
+    return std::regex_match(path, regex);
+  } catch (const std::regex_error&) {
+    return path.find(pattern) != std::string::npos;
+  }
+}
+
+}  // namespace Ignore
+}  // namespace BMS
