+void RenderViewImpl::OnBmsSearch(const std::string& query) {
+  BMS_DEBUG_LOG("BMS Search (Renderer): " << query);
+
+  // Perform search using BMS search engine
+  if (bms_renderer_) {
+    auto results = bms_renderer_->Search(query);
+
+    // Display results in renderer
+    if (webview_) {
+      std::string html = "<html><head><title>Search Results</title>";
+      html += "<style>body { font-family: Arial; margin: 40px; } ";
+      html += ".result { border-bottom: 1px solid #eee; padding: 10px; } ";
+      html += ".result:hover { background: #f5f5f5; } ";
+      html += ".title { font-size: 1.2em; color: #1a0dab; } ";
+      html += ".url { color: #006621; font-size: 0.9em; } ";
+      html += ".snippet { color: #545454; margin-top: 5px; } ";
+      html += "</style></head><body>";
+      html += "<h1>🔍 BMS Search Results</h1>";
+      html += "<p>Showing results for: <strong>" + query + "</strong></p>";
+      html += "<hr>";
+
+      if (results.empty()) {
+        html += "<p>No results found. Try a different search.</p>";
+      } else {
+        for (const auto& result : results) {
+          html += "<div class='result'>";
+          html += "<div class='title'>";
+          html += "<a href='" + result.url + "'>" + result.title + "</a>";
+          html += "</div>";
+          html += "<div class='url'>" + result.url + "</div>";
+          html += "<div class='snippet'>" + result.snippet + "</div>";
+          html += "</div>";
+        }
+      }
+
+      html += "</body></html>";
+
+      // Load search results page
+      GURL data_url("data:text/html;charset=utf-8," + html);
+      webview_->MainFrame()->LoadRequest(blink::WebURLRequest(data_url));
+    }
+  }
+}
+
+void RenderViewImpl::OnBmsIgnore(const std::string& path) {
+  BMS_DEBUG_LOG("BMS Ignore (Renderer): " << path);
+
+  if (bms_renderer_) {
+    bms_renderer_->IgnorePath(path);
+  }
+}
+
+void RenderViewImpl::OnBmsApiCall(const std::string& name,
+                                  const std::string& data) {
+  BMS_DEBUG_LOG("BMS API Call (Renderer): " << name);
+
+  if (bms_renderer_) {
+    auto response = bms_renderer_->CallApi(name, data);
+    // Send response back to browser
+    Send(new ViewHostMsg_BMS_ApiResponse(routing_id_, response));
+  }
+}
+
+void RenderViewImpl::OnBmsDomQuery(const std::string& selector) {
+  BMS_DEBUG_LOG("BMS DOM Query (Renderer): " << selector);
+
+  if (webview_) {
+    blink::WebDocument document = webview_->MainFrame()->GetDocument();
+    auto element = document.QuerySelector(blink::WebString::FromUTF8(selector));
+    if (!element.IsNull()) {
+      // Send element data back to browser
+      std::string html = element.OuterHTML().Utf8();
+      Send(new ViewHostMsg_BMS_DomResult(routing_id_, html));
+    }
+  }
+}
+
+void RenderViewImpl::OnBmsCustomElement(const std::string& name,
+                                       const std::string& code) {
+  BMS_DEBUG_LOG("BMS Custom Element (Renderer): " << name);
+
+  if (webview_) {
+    // Execute JavaScript to define custom element
+    std::string script = R"(
+      if (!customElements.get(')" + name + R"(')) {
+        class )" + name + R"( extends HTMLElement {
+          constructor() {
+            super();
+            this.attachShadow({mode: 'open'});
+          }
+          connectedCallback() {
+            this.shadowRoot.innerHTML = `)" + code + R"(`;
+          }
+        }
+        customElements.define(')" + name + R"(', )" + name + R"();
+      }
+    )";
+
